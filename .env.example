# Memory Magic Backend Environment Variables Template

# Application Port (Render automatically sets this, defaults to 8080 locally)
PORT=8080

# Active Spring Profile (dev, prod, test)
SPRING_PROFILES_ACTIVE=dev

# PostgreSQL Database Configuration
SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/memory_magic_db
SPRING_DATASOURCE_USERNAME=postgres
SPRING_DATASOURCE_PASSWORD=postgres

# Allowed CORS Origins (comma-separated; wildcard pattern supported)
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8080,https://*.netlify.app
